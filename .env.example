# Copy to .env and fill in real values. Never commit .env.

RASA_LICENSE=
OPENAI_API_KEY=

# Slack (channel + notify_slack skill + rasa-versary job)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALLOWED_CHANNELS=
# Rasa-versary DMs need: users:read, users.profile:read, im:write, chat:write
# GIF/image viewing + voice downloads need: files:read (private Slack URLs)
# Run: python scripts/rasa_versary.py --dry-run
# Optional vision model for describing GIFs/images (default gpt-4.1-mini)
# OPENAI_VISION_MODEL=gpt-4.1-mini

# Deepgram — Slack voice message / audio transcription (inbound only)
DEEPGRAM_API_KEY=
# Optional model override (default nova-2)
# DEEPGRAM_MODEL=nova-2

# Notion (search_policies / company docs)
NOTION_API_KEY=
NOTION_POLICIES_ROOT_ID=
# Who's Who employee directory database id (lookup_employee skill)
NOTION_WHOS_WHO_DB_ID=