# Copy to .env and fill in real values. Never commit .env.

RASA_LICENSE=
OPENAI_API_KEY=

# --- Notion (search_policies) ---
# Create an internal integration at https://www.notion.so/my-integrations
# Share your handbook pages/database with that integration.
NOTION_API_KEY=
# Who's Who employee directory database (lookup_employee skill)
NOTION_WHOS_WHO_DB_ID=

# --- Slack (notify_slack) ---
# Slack app bot token with channels:read, chat:write; invite bot to channels.
SLACK_BOT_TOKEN=
# Optional: comma-separated channel names the agent may post to (without #)
SLACK_ALLOWED_CHANNELS=

# Slack Events API signing secret (Basic Information → App Credentials)
SLACK_SIGNING_SECRET=

# Deepgram — Slack voice message transcription
DEEPGRAM_API_KEY=

# Channels where Sara replies without @mention
SLACK_ALWAYS_REPLY_CHANNELS=

# Optional: extra Slack bot/user IDs to ignore (comma-separated)
SLACK_IGNORE_BOT_IDS=

# Giphy — outbound GIF replies
GIPHY_API_KEY=

# Spotify — preferred for play_music (falls back to Apple Music if empty)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
