# Copy to .env and fill in real values. Never commit .env.

RASA_LICENSE=
OPENAI_API_KEY=

# Slack (channel + notify_slack skill + rasa-versary job)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALLOWED_CHANNELS=
# Channels where Sara answers every message without @mention (comma-separated
# channel IDs, e.g. C0BP9BQ1084). Bot must be invited; Slack app needs
# message.channels (and/or message.groups) + channels:history / groups:history.
SLACK_ALWAYS_REPLY_CHANNELS=
# Helpdesk intake channels (hybrid Wrangle + Notion mirror). Defaults to
# SLACK_ALWAYS_REPLY_CHANNELS when empty. Put #helpdesk here. Invite Sara;
# turn OFF Wrangle "auto-create from every channel message" on this channel
# so Sara is the only ticket creator (avoids duplicates).
SLACK_HELPDESK_CHANNELS=
# Optional: extra Slack bot user/bot IDs to ignore (comma-separated), e.g. the
# Wrangle app bot if it ever posts as a user Sara would otherwise answer.
SLACK_IGNORE_BOT_IDS=
# Rasa-versary DMs need: users:read, users.profile:read, im:write, chat:write
# GIF/image viewing + voice downloads need: files:read (private Slack URLs)
# Run: python scripts/rasa_versary.py --dry-run
# Optional vision model for describing GIFs/images (default gpt-4.1-mini)
# OPENAI_VISION_MODEL=gpt-4.1-mini

# Deepgram — Slack voice message / audio transcription (inbound only)
DEEPGRAM_API_KEY=
# Optional model override (default nova-2)
# DEEPGRAM_MODEL=nova-2

# Giphy — outbound GIF replies (send_gif skill)
GIPHY_API_KEY=

# Spotify — preferred for play_music (Client Credentials). If unset, falls
# back to free iTunes / Apple Music search.
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Notion (search_policies / company docs)
NOTION_API_KEY=
NOTION_POLICIES_ROOT_ID=
# Who's Who employee directory database id (lookup_employee skill)
NOTION_WHOS_WHO_DB_ID=
# Helpdesk Mirror database (reporting only — agents work tickets in Wrangle).
# Share the DB with Sara's Notion integration. Expected properties:
#   Name (title), Ticket ID (rich_text),
#   Team (select: General / Ops, IT Support, Payhawk / Finance, People / HR,
#     Rasa Swag, Rev Ops, Security and Compliance, Software request),
#   Status (select: Open/NEW/IN_PROGRESS/ON_HOLD/RESOLVED/CLOSED),
#   Wrangle URL (url), Requester (rich_text), Channel (rich_text),
#   Slack ts (rich_text), Created (date), Resolved (date, optional)
NOTION_HELPDESK_MIRROR_DB_ID=

# Wrangle API (paid) — https://slack.wrangle.io/integrations
# Inbox UUIDs from each inbox's settings (names match Rasa Wrangle inboxes).
WRANGLE_API_TOKEN=
WRANGLE_SLACK_USER_ID=
WRANGLE_SLACK_WORKSPACE_ID=
WRANGLE_INBOX_OPS=          # General / Ops request
WRANGLE_INBOX_IT=           # IT Support
WRANGLE_INBOX_FINANCE=      # Payhawk / Finance
WRANGLE_INBOX_HR=           # People / HR Issues
WRANGLE_INBOX_SWAG=         # Rasa Swag
WRANGLE_INBOX_REVOPS=       # Rev Ops
WRANGLE_INBOX_SECURITY=     # Security and Compliance
WRANGLE_INBOX_SOFTWARE=     # Software request
